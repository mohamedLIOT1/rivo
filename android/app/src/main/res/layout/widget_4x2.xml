<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg_4x2"
    android:padding="14dp">

    <!-- Top Row: Artwork, Info & Heart -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/widget_42_art"
            android:layout_width="62dp"
            android:layout_height="62dp"
            android:scaleType="centerCrop"
            android:background="#162329"
            android:src="@drawable/logo"
            android:contentDescription="Album Art" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NOW PLAYING"
                android:textSize="9sp"
                android:textStyle="bold"
                android:textColor="#2dd4bf"
                android:letterSpacing="0.06" />

            <TextView
                android:id="@+id/widget_42_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Rivo Music"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:singleLine="true"
                android:ellipsize="end"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/widget_42_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Playing in Background"
                android:textSize="12sp"
                android:textColor="#94a3b8"
                android:singleLine="true"
                android:ellipsize="end"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/widget_42_btn_like"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_notification_like"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:tint="#94a3b8"
            android:contentDescription="Favorite" />
    </LinearLayout>

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Playback Controls Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp">

        <ImageButton
            android:id="@+id/widget_42_btn_shuffle"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_notification_shuffle"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:tint="#94a3b8"
            android:contentDescription="Shuffle" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/widget_42_btn_prev"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_notification_prev"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:tint="#FFFFFF"
            android:contentDescription="Previous" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/widget_42_btn_play_pause"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_notification_pause"
            android:background="@drawable/lock_play_circle"
            android:tint="#042f2e"
            android:contentDescription="Play/Pause" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/widget_42_btn_next"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_notification_next"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:tint="#FFFFFF"
            android:contentDescription="Next" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/widget_42_btn_repeat"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_notification_repeat"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:tint="#94a3b8"
            android:contentDescription="Repeat" />
    </LinearLayout>

</LinearLayout>
