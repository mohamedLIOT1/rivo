<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#070d0b">

    <!-- Ambient blurred background cover -->
    <ImageView
        android:id="@+id/lock_bg_art"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0.25" />

    <!-- Dark gradient scrim -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B3070d0b" />

    <!-- Main Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="48dp"
        android:paddingBottom="28dp">

        <!-- Header: Close button & Digital Clock -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageButton
                android:id="@+id/btn_lock_close"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_notification_prev"
                android:rotation="270"
                app:tint="#A0FFFFFF"
                android:contentDescription="Dismiss" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <TextClock
                    android:id="@+id/lock_clock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:format12Hour="h:mm"
                    android:format24Hour="HH:mm"
                    android:textSize="50sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF" />

                <TextClock
                    android:id="@+id/lock_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:format12Hour="EEEE, MMMM d"
                    android:format24Hour="EEEE, d MMMM"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#17A398"
                    android:textAllCaps="true"
                    android:letterSpacing="0.06" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Center Viewport: Album Artwork with CardView -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center">

            <androidx.cardview.widget.CardView
                android:layout_width="240dp"
                android:layout_height="240dp"
                android:layout_gravity="center"
                app:cardCornerRadius="24dp"
                app:cardElevation="16dp"
                app:cardBackgroundColor="#101816">

                <ImageView
                    android:id="@+id/lock_cover_art"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/logo"
                    android:contentDescription="Album Artwork" />
            </androidx.cardview.widget.CardView>
        </FrameLayout>

        <!-- Track Info: Title & Artist -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/lock_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rivo Music"
                android:textSize="19sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:singleLine="true"
                android:ellipsize="marquee"
                android:marqueeRepeatLimit="marquee_forever"
                android:scrollHorizontally="true"
                android:gravity="center" />

            <TextView
                android:id="@+id/lock_artist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Playing in Background"
                android:textSize="13sp"
                android:textColor="#88b0a7"
                android:layout_marginTop="4dp"
                android:singleLine="true"
                android:ellipsize="end"
                android:gravity="center" />
        </LinearLayout>

        <!-- Progress Seekbar and timestamps -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <SeekBar
                android:id="@+id/lock_seekbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:progressTint="#17A398"
                android:thumbTint="#FFFFFF"
                android:max="1000" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:layout_marginTop="2dp">

                <TextView
                    android:id="@+id/lock_time_current"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0:00"
                    android:textSize="11sp"
                    android:textColor="#88b0a7" />

                <TextView
                    android:id="@+id/lock_time_total"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="0:00"
                    android:textSize="11sp"
                    android:textColor="#88b0a7" />
            </RelativeLayout>
        </LinearLayout>

        <!-- 5-Button Media Row: Shuffle | Prev | Play/Pause | Next | Repeat -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <ImageButton
                android:id="@+id/btn_lock_shuffle"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_notification_shuffle"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                app:tint="#94A3B8"
                android:contentDescription="Shuffle" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/btn_lock_prev"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_notification_prev"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                app:tint="#FFFFFF"
                android:contentDescription="Previous" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/btn_lock_play_pause"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:src="@drawable/ic_notification_pause"
                android:background="@drawable/lock_play_circle"
                app:tint="#042F2E"
                android:elevation="6dp"
                android:contentDescription="Play/Pause" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/btn_lock_next"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_notification_next"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                app:tint="#FFFFFF"
                android:contentDescription="Next" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/btn_lock_repeat"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_notification_repeat"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                app:tint="#94A3B8"
                android:contentDescription="Repeat" />
        </LinearLayout>

        <!-- Tap or Swipe hint to unlock -->
        <TextView
            android:id="@+id/lock_unlock_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="SWIPE OR PRESS BACK TO UNLOCK"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:textColor="#60FFFFFF"
            android:letterSpacing="0.08"
            android:paddingTop="6dp" />

    </LinearLayout>

</RelativeLayout>
