<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_4x1"
    android:padding="8dp">

    <!-- Album Artwork Thumbnail (Click to open app) -->
    <ImageView
        android:id="@+id/widget_41_art"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:scaleType="centerCrop"
        android:background="#162329"
        android:src="@drawable/logo"
        android:contentDescription="Album Art" />

    <!-- Playback Controls on Right -->
    <LinearLayout
        android:id="@+id/widget_41_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/widget_41_btn_prev"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_notification_prev"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:tint="#FFFFFF"
            android:contentDescription="Previous" />

        <ImageButton
            android:id="@+id/widget_41_btn_play_pause"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:src="@drawable/ic_notification_pause"
            android:background="@drawable/lock_play_circle"
            android:tint="#042f2e"
            android:contentDescription="Play/Pause" />

        <ImageButton
            android:id="@+id/widget_41_btn_next"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_notification_next"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:tint="#FFFFFF"
            android:contentDescription="Next" />
    </LinearLayout>

    <!-- Track Title and Artist in Center -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@id/widget_41_art"
        android:layout_toStartOf="@id/widget_41_controls"
        android:layout_centerVertical="true"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <TextView
            android:id="@+id/widget_41_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Rivo Music"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_41_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Playing in Background"
            android:textSize="11sp"
            android:textColor="#94a3b8"
            android:singleLine="true"
            android:ellipsize="end"
            android:layout_marginTop="2dp" />
    </LinearLayout>

</RelativeLayout>
