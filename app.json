{
  "expo": {
    "name": "Rivo",
    "slug": "rivo",
    "version": "2.4.47",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0b1110"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rivo.app",
      "buildNumber": "167",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "NSMicrophoneUsageDescription": "Rivo requires microphone access to listen to and identify songs via Song Radar.",
        "NSSpeechRecognitionUsageDescription": "Rivo uses speech and audio recognition for Song Radar."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0b1110"
      },
      "package": "com.rivo.app",
      "versionCode": 167,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.WAKE_LOCK",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    }
  }
}
