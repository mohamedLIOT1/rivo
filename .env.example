# =====================================================================
# Rivo Configuration Template (.env.example)
# Copy this file to .env and fill in your actual production values.
# NEVER commit the real .env file or real secrets to source control.
# =====================================================================

# Server Port
PORT=5000

# MongoDB Atlas / Local Connection URI
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/rivo?retryWrites=true&w=majority

# YouTube Data API v3 Key
YOUTUBE_API_KEY=your_youtube_api_key_here
# Supports multiple comma-separated keys for auto-rotation
YOUTUBE_API_KEYS=key1,key2,key3

# SoundCloud Client ID (Optional)
SOUNDCLOUD_CLIENT_ID=your_soundcloud_client_id_here

# JWT Authentication Secret (MUST be a high-entropy 64+ char random string)
JWT_SECRET=generate_a_cryptographically_secure_random_64_character_string_here

# Admin Email Whitelist (Comma-separated)
ADMIN_EMAILS=admin@rivo.app

# AI Lyrics & Recommendation Provider API Keys
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Frontend / Web Client API Base URL
VITE_API_URL=https://rivo-m.duckdns.org

# Discord Bot / RPC Integration (Optional)
BOT_TOKEN=your_discord_bot_token_here
ENCRYPTION_KEY=your_32_byte_aes_encryption_key_here
