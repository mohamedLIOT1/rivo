{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rivo",
  "version": "2.1.7",
  "identifier": "com.rivo.desktop",
  "mainBinaryName": "Rivo",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Rivo \u2014 Hi-Fi Audio Player",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "devtools": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: https: data: blob:; media-src 'self' asset: https: data: blob:; connect-src 'self' ipc: http://ipc.localhost https://rivo-m.duckdns.org wss://rivo-m.duckdns.org https://api.github.com https://*.googlevideo.com https://*.ytimg.com https://*.sndcdn.com; font-src 'self' data: https:;",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPLOCALDATA/downloads/**",
          "$DOWNLOAD/**",
          "$TEMP/Rivo/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/installer-header.bmp",
        "sidebarImage": "icons/installer-sidebar.bmp",
        "uninstallerIcon": "icons/icon.ico",
        "uninstallerHeaderImage": "icons/installer-header.bmp",
        "installerHooks": "installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIxNTIzNTA2NENDNDQ4QTcKUldTblNNUk1CalZTc1hycUVESDVDVEJ0d2Rsa2luRFd4Q2JjUVF6dHphalpPTFNsbXY5WVM0RTAK",
      "endpoints": [
        "https://github.com/WhooAre-you/Rivo/releases/latest/download/windows-update.json",
        "https://rivo-m.duckdns.org/downloads/windows-update.json"
      ]
    }
  }
}