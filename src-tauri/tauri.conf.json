{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rivo",
  "version": "1.9.3",
  "identifier": "com.rivo.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Rivo — Hi-Fi Audio Player",
        "url": "index.html",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/installer-header.bmp",
        "sidebarImage": "icons/installer-sidebar.bmp",
        "uninstallerIcon": "icons/icon.ico",
        "uninstallerHeaderImage": "icons/installer-header.bmp"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIxNTIzNTA2NENDNDQ4QTcKUldTblNNUk1CalZTc1hycUVESDVDVEJ0d2Rsa2luRFd4Q2JjUVF6dHphalpPTFNsbXY5WVM0RTAK",
      "endpoints": [
        "https://github.com/WhooAre-you/Rivo/releases/latest/download/windows-update.json",
        "https://rivo-m.duckdns.org/downloads/windows-update.json"
      ]
    }
  }
}
